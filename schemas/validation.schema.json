{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulngym.example/schemas/validation.schema.json",
  "title": "VulnGym T1 field validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "input_line",
    "report_id",
    "verdict",
    "fields",
    "summary",
    "missing_information"
  ],
  "properties": {
    "entry_id": {
      "type": ["string", "null"],
      "pattern": "^entry-[0-9]{5}$"
    },
    "input_line": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "report_id": {
      "type": ["string", "null"],
      "pattern": "^GHSA-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$"
    },
    "verdict": {
      "$ref": "#/$defs/status"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "schema": { "$ref": "#/$defs/fieldValidation" },
        "evidence_package": { "$ref": "#/$defs/fieldValidation" },
        "commit": { "$ref": "#/$defs/fieldValidation" },
        "critical_operation": { "$ref": "#/$defs/fieldValidation" },
        "entry_id": { "$ref": "#/$defs/fieldValidation" },
        "entry_point": { "$ref": "#/$defs/fieldValidation" },
        "origin": { "$ref": "#/$defs/fieldValidation" },
        "project": { "$ref": "#/$defs/fieldValidation" },
        "repo_url": { "$ref": "#/$defs/fieldValidation" },
        "report_id": { "$ref": "#/$defs/fieldValidation" },
        "source_link": { "$ref": "#/$defs/fieldValidation" },
        "trace": { "$ref": "#/$defs/fieldValidation" },
        "verify": { "$ref": "#/$defs/fieldValidation" },
        "vuln_category_l1": { "$ref": "#/$defs/fieldValidation" },
        "vuln_category_l2": { "$ref": "#/$defs/fieldValidation" },
        "vuln_ids": { "$ref": "#/$defs/fieldValidation" },
        "vuln_title": { "$ref": "#/$defs/fieldValidation" }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "missing_information": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["correct", "incorrect", "uncertain"]
    },
    "line": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "file", "line"],
      "properties": {
        "code": { "type": "string" },
        "desc": { "type": "string" },
        "file": { "type": "string" },
        "line": { "$ref": "#/$defs/line" }
      }
    },
    "officialFieldValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "integer", "enum": [0, 1] },
        {
          "type": "array",
          "items": { "type": "string" }
        },
        { "$ref": "#/$defs/location" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        }
      ]
    },
    "fieldValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "evidence"],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Z0-9][A-Z0-9._-]*$"
          }
        },
        "suggested_fix": {
          "$ref": "#/$defs/officialFieldValue"
        }
      }
    }
  }
}
