{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulngym.example/schemas/repair_plan.schema.json",
  "title": "VulnGym B-v2 RepairPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "report_id",
    "entry_id",
    "repair_iteration",
    "previous_candidate_sha256",
    "validation_sha256",
    "repair_fields",
    "dependent_fields",
    "locked_fields",
    "locked_field_hashes",
    "global_actions",
    "instructions"
  ],
  "properties": {
    "task_id": {
      "$ref": "#/$defs/taskId"
    },
    "report_id": {
      "type": ["string", "null"],
      "pattern": "^GHSA-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$"
    },
    "entry_id": {
      "type": ["string", "null"],
      "pattern": "^entry-[0-9]{5}$"
    },
    "repair_iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "previous_candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "validation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repair_fields": {
      "$ref": "#/$defs/nonEmptyFieldArray"
    },
    "dependent_fields": {
      "$ref": "#/$defs/fieldArray"
    },
    "locked_fields": {
      "$ref": "#/$defs/fieldArray"
    },
    "locked_field_hashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/fieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "maxProperties": 15
    },
    "global_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instructions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 15,
      "propertyNames": {
        "$ref": "#/$defs/fieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/instruction"
      }
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fieldName": {
      "type": "string",
      "enum": [
        "commit",
        "critical_operation",
        "entry_id",
        "entry_point",
        "origin",
        "project",
        "repo_url",
        "report_id",
        "source_link",
        "trace",
        "verify",
        "vuln_category_l1",
        "vuln_category_l2",
        "vuln_ids",
        "vuln_title"
      ]
    },
    "fieldArray": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/fieldName"
      }
    },
    "nonEmptyFieldArray": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/fieldName"
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_codes",
        "evidence",
        "evidence_refs",
        "suggested_fix",
        "required_checks",
        "allowed_tools"
      ],
      "properties": {
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Z0-9][A-Z0-9._-]*$"
          }
        },
        "suggested_fix": {
          "$ref": "#/$defs/jsonValue"
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  },
  "$comment": "RepairPlan enforces disjoint field partitions, exact dependency closure, instruction/repair key equality, and locked hash equality in the Python model because Draft 2020-12 cannot express those dynamic cross-property invariants portably."
}
