{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulngym.example/schemas/evidence.schema.json",
  "title": "VulnGym internal evidence item",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "report_id", "source_type", "snippet"],
  "dependentRequired": {
    "line_start": ["line_end"],
    "line_end": ["line_start"]
  },
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9][A-Z0-9._-]*$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^GHSA-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^entry-[0-9]{5}$"
    },
    "source_type": {
      "type": "string",
      "enum": ["advisory", "patch", "source", "git", "schema"]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "file": {
      "type": "string"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "snippet": {
      "type": "string",
      "minLength": 1
    },
    "tool_call_id": {
      "type": "string"
    }
  },
  "$comment": "When line_start and line_end are present, producers must enforce line_start <= line_end. Evidence is an internal sidecar and must never be merged into an official entry row."
}
